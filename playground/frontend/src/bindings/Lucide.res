// lucide-react icon bindings. ReScript allows only one `@react.component` per
// module, so each icon lives in its own submodule. Call as `<Lucide.Github />`.

module Bug = {
  @module("lucide-react") @react.component
  external make: (~size: int=?, ~className: string=?) => React.element = "Bug"
}
module Check = {
  @module("lucide-react") @react.component
  external make: (~size: int=?, ~className: string=?) => React.element = "Check"
}
